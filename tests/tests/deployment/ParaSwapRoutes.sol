pragma solidity 0.8.19;

// ParaSwap v6.2 `swapExactAmountIn` (generic executor) parameters, UniswapV3-only routes, WETH -> USDC, 0.1 WETH in.
// Obtained from the ParaSwap Swap Endpoint with `onlyParams=true`, `includeDEXS=UniswapV3`,
// `includeContractMethods=swapExactAmountIn`, `slippage=3`, `version=6.2`, e.g.
// https://api.paraswap.io/swap?srcToken=<WETH>&srcDecimals=18&destToken=<USDC>&destDecimals=6&amount=100000000000000000&network=<id>&slippage=3&side=SELL&version=6.2&onlyParams=true&includeDEXS=UniswapV3&includeContractMethods=swapExactAmountIn&userAddress=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
// The calldata is only valid near `forkBlock`, which is the price route block reported by the API.

struct ParaSwapRoute {
    uint256 forkBlock;
    address executor;
    address srcToken;
    address destToken;
    uint256 fromAmount;
    uint256 toAmount;
    uint256 quotedAmount;
    bytes32 metadata;
    uint256 partnerAndFee;
    bytes executorData;
}

