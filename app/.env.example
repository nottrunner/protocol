# Copy to .env.local. NEVER commit real keys. All NEXT_PUBLIC_* values are exposed to the browser.

# WalletConnect Cloud project id (https://cloud.reown.com). Optional: if unset, only
# injected / browser wallets (MetaMask, Coinbase extension, Rabby, ...) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC overrides. Leave blank to use the public default endpoints (rate-limited; use a
# dedicated provider such as Alchemy for anything beyond local dev).
NEXT_PUBLIC_RPC_URL_ETHEREUM=
NEXT_PUBLIC_RPC_URL_BASE=
NEXT_PUBLIC_RPC_URL_ARBITRUM=
NEXT_PUBLIC_RPC_URL_ROBINHOOD=

# Deployed contract addresses (0x...). Leave blank until the protocol is deployed on the chain.
# FundDeployer is the only address the app needs for Create Portfolio; deposit/redeem use the
# per-vault Comptroller discovered from the vault proxy.
NEXT_PUBLIC_FUND_DEPLOYER_ETHEREUM=
NEXT_PUBLIC_FUND_DEPLOYER_BASE=
NEXT_PUBLIC_FUND_DEPLOYER_ARBITRUM=
NEXT_PUBLIC_FUND_DEPLOYER_ROBINHOOD=
