# Copy to .env.local. NEVER commit real keys. All NEXT_PUBLIC_* values are exposed to the browser.

# WalletConnect Cloud project id (https://cloud.reown.com). Optional: if unset, only
# injected / browser wallets (MetaMask, Coinbase extension, Rabby, ...) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC endpoints, one per chain. Leave blank (or delete the line) to use the public default; an empty
# value is treated as unset. Values must be http(s) URLs; a malformed value fails the build/startup.
# Defaults are rate-limited public endpoints: use a dedicated provider (e.g. Alchemy) beyond local dev.
# These are NEXT_PUBLIC_* and are inlined at BUILD time: rebuild after changing them. Never put
# secret-bearing URLs here unless you accept that they are shipped to the browser.
#
# QA against a local Anvil fork: point a chain at it, e.g. NEXT_PUBLIC_RPC_URL_ETHEREUM=http://127.0.0.1:8545
# (see README "Pointing a build at a local fork").
#
# Ethereum (chain id 1).            Default: https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL_ETHEREUM=
# Base (chain id 8453).             Default: https://mainnet.base.org
NEXT_PUBLIC_RPC_URL_BASE=
# Robinhood Chain (chain id 4663).  Default: https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RPC_URL_ROBINHOOD=
# Arbitrum One (chain id 42161).    Default: https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_RPC_URL_ARBITRUM=

# --- Deployed contract addresses -----------------------------------------------------------------------------------
# The app reads per-chain addresses from the repo's deployments/<chain>.json records (written by script/DeployCore.s.sol,
# branch feat/deploy-scripts) at BUILD time. Only records labelled `"mainnet": true` / kind "mainnet broadcast" are used by
# default; fork records ("fork, not mainnet") are ignored unless NEXT_PUBLIC_USE_FORK_DEPLOYMENTS=1 (below).
# DEPLOYMENTS_DIR (build time only, not exposed to the browser) overrides the records directory (default ../deployments).
#
# The NEXT_PUBLIC_*_<CHAIN> variables below are EXPLICIT OVERRIDES and always win over a record (no flag needed), so QA can
# point a build at a local-fork deployment without code changes. If NEXT_PUBLIC_FUND_DEPLOYER_<CHAIN> differs from the
# record's fundDeployer, the whole record for that chain is superseded (addresses are never mixed).
# CHAIN = ETHEREUM | BASE | ARBITRUM | ROBINHOOD. Leave blank to use the record.
DEPLOYMENTS_DIR=
NEXT_PUBLIC_FUND_DEPLOYER_ETHEREUM=
NEXT_PUBLIC_FUND_DEPLOYER_BASE=
NEXT_PUBLIC_FUND_DEPLOYER_ARBITRUM=
NEXT_PUBLIC_FUND_DEPLOYER_ROBINHOOD=
# Optional per chain (same suffixes): NEXT_PUBLIC_VALUE_INTERPRETER_<CHAIN>, NEXT_PUBLIC_FUND_VALUE_CALCULATOR_ROUTER_<CHAIN>,
# NEXT_PUBLIC_DEPLOY_BLOCK_<CHAIN> (first block for NewFundCreated log scans; a fork's fork block is fine),
# NEXT_PUBLIC_DENOMINATION_ASSETS_<CHAIN> ("USDC:0x...,USDG:0x..." allowed denomination assets),
# NEXT_PUBLIC_UNISWAP_V3_ADAPTER_<CHAIN> (Ethereum, Arbitrum), NEXT_PUBLIC_UNISWAP_V3_SWAPROUTER02_ADAPTER_<CHAIN> (Base),
# NEXT_PUBLIC_UNISWAP_V3_QUOTER_<CHAIN> (QuoterV2; defaults to the official address). Swaps stay hidden without an adapter.

# --- Fork deployment records (TEST-ONLY; see README "Deployment addresses") ---------------------------------------
# Set to 1 (or true) ONLY for QA builds against local Anvil forks: embeds fork / unlabelled records from deployments/. Unset
# (default): fork-only addresses are NOT in the bundle. The build FAILS if this is set while VERCEL_ENV=production.
NEXT_PUBLIC_USE_FORK_DEPLOYMENTS=

# --- E2E mock wallet (TEST-ONLY; see README "E2E mock wallet (test-only)") ---------------------------------
# Build flag. Set to 1 (or true) ONLY for QA / E2E builds: adds an "E2E Mock Wallet" option that signs in-page
# with a PUBLIC Anvil key and sends through the NEXT_PUBLIC_RPC_URL_* endpoints. Leave unset otherwise: then the
# connector and the key are compiled out of the bundle. The build FAILS if this is set while VERCEL_ENV=production.
NEXT_PUBLIC_E2E_MOCK_WALLET=
# Which Anvil default account signs (0-9; same index as qa/fixtures.json anvilAccounts on feat/deploy-scripts:
# 0 deployer, 1 QA vault manager, 2 depositor A, 3 depositor B). Blank = 0.
NEXT_PUBLIC_E2E_MOCK_ACCOUNT_INDEX=
# Optional explicit 0x private key; overrides the index. Anvil/test keys ONLY, never a real key (it ships to the browser).
NEXT_PUBLIC_E2E_MOCK_PRIVATE_KEY=
