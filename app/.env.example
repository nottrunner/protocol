# Copy to .env.local. NEVER commit real keys. All NEXT_PUBLIC_* values are exposed to the browser.

# WalletConnect Cloud project id (https://cloud.reown.com). Optional: if unset, only
# injected / browser wallets (MetaMask, Coinbase extension, Rabby, ...) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC endpoints, one per chain. Leave blank (or delete the line) to use the public default; an empty
# value is treated as unset. Values must be http(s) URLs; a malformed value fails the build/startup.
# Defaults are rate-limited public endpoints: use a dedicated provider (e.g. Alchemy) beyond local dev.
# These are NEXT_PUBLIC_* and are inlined at BUILD time: rebuild after changing them. Never put
# secret-bearing URLs here unless you accept that they are shipped to the browser.
#
# QA against a local Anvil fork: point a chain at it, e.g. NEXT_PUBLIC_RPC_URL_ETHEREUM=http://127.0.0.1:8545
# (see README "Pointing a build at a local fork").
#
# Ethereum (chain id 1).            Default: https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL_ETHEREUM=
# Base (chain id 8453).             Default: https://mainnet.base.org
NEXT_PUBLIC_RPC_URL_BASE=
# Robinhood Chain (chain id 4663).  Default: https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RPC_URL_ROBINHOOD=
# Arbitrum One (chain id 42161).    Default: https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_RPC_URL_ARBITRUM=

# Deployed contract addresses (0x...). Leave blank until the protocol is deployed on the chain.
# FundDeployer is the only address the app needs for Create Portfolio; deposit/redeem use the
# per-vault Comptroller discovered from the vault proxy.
NEXT_PUBLIC_FUND_DEPLOYER_ETHEREUM=
NEXT_PUBLIC_FUND_DEPLOYER_BASE=
NEXT_PUBLIC_FUND_DEPLOYER_ARBITRUM=
NEXT_PUBLIC_FUND_DEPLOYER_ROBINHOOD=
